## Title screen: a night scene lit by the shrine and the keeper's lantern, the logo, and the main menu.
## Debug (after --): --shot=<file> [--state=options|credits]
extends Node2D

const Player := preload("res://scripts/game/player.gd")
const MenuList := preload("res://scripts/game/menu_list.gd")
const OptionsPanel := preload("res://scripts/game/options_panel.gd")

const FONT: Font = preload("res://assets/ui/font/emberwick_font.fnt")
const BOX: Texture2D = preload("res://assets/ui/dialogue_box.png")
const LOGO: Texture2D = preload("res://assets/ui/logo.png")
const MOON: Texture2D = preload("res://assets/ui/moon.png")
const MIST: Texture2D = preload("res://assets/fx/mist_overlay.png")
const GRASS: Texture2D = preload("res://assets/tilesets/terrain_grass.png")
const TREE_L: Texture2D = preload("res://assets/props/tree_large.png")
const TREE_S: Texture2D = preload("res://assets/props/tree_small.png")
const PLAYER: SpriteFrames = preload("res://resources/frames_player.tres")
const CAT: SpriteFrames = preload("res://resources/frames_cat.tres")
const SHRINE: SpriteFrames = preload("res://resources/frames_shrine.tres")

const CREDITS := "EMBERWICK\nA LANTERN KEEPER'S TALE\n\n\nMADE WITH\nCLAUDE CODE AND GODOT 4.7\n\nPIXEL ART\nGENERATED BY PYTHON SCRIPTS\n\nMUSIC\nGOOGLE LYRIA 3\n\nVOICES\nGEMINI 3.8 FLASH TTS\n\nSOUND EFFECTS\nSYNTHESISED BY SCRIPT\n\n\nTHANK YOU FOR PLAYING"

var _state := "main"
var _go := false
var _t := 0.0
var _menu: Control
var _options_box: Control
var _options: Control
var _credits_box: Control
var _credits_text: Label
var _mist: TextureRect
var _logo: TextureRect
var _fireflies: Array = []
var _shrine_light: PointLight2D
var _shot := ""
var _frame := 0


func _ready() -> void:
	Player.ensure_input()
	get_tree().root.set_meta("intro_done", false)
	_build_sky()
	_build_world()
	_build_ui()
	Audio.play_music("mistwood", 3.0)
	var open_state := ""
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--shot="):
			_shot = a.substr(7)
		elif a.begins_with("--state="):
			open_state = a.substr(8)
		elif a == "--leave-test":
			print("TITLE REACHED (state intro_done=", get_tree().root.get_meta("intro_done", "unset"), ")")
		elif a == "--auto-start":
			get_tree().create_timer(1.0).timeout.connect(_new_game)
		elif a.begins_with("--opt-test="):    # persistence check: "set" changes volumes, "get" prints what was loaded
			if a.substr(11) == "set":
				Audio.set_step("music", 4)
				Audio.set_step("voice", 7)
			print("OPT music=", Audio.get_step("music"), " sfx=", Audio.get_step("sfx"), " voice=", Audio.get_step("voice"))
			if a.substr(11) == "reset":
				for k in ["music", "sfx", "voice"]:
					Audio.set_step(k, 10)
				print("OPT reset")
	if open_state != "":
		_show(open_state)
	Transition.fade_in(1.8)


# ------------------------------------------------------------------ background (unlit canvas layer behind everything)
func _band(offsets: Array, colors: Array, h: int) -> TextureRect:
	var g := Gradient.new()
	g.interpolation_mode = Gradient.GRADIENT_INTERPOLATE_CONSTANT      # stepped bands, like pixel-art skies
	g.offsets = PackedFloat32Array(offsets)
	g.colors = PackedColorArray(colors)
	var gt := GradientTexture2D.new()
	gt.gradient = g
	gt.width = 1
	gt.height = h
	gt.fill_from = Vector2(0, 0)
	gt.fill_to = Vector2(0, 1)
	var r := TextureRect.new()
	r.texture = gt
	r.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	r.stretch_mode = TextureRect.STRETCH_SCALE
	return r


func _radial(color: Color, size: int) -> GradientTexture2D:
	var g := Gradient.new()
	g.colors = PackedColorArray([color, Color(color.r, color.g, color.b, 0.0)])
	var gt := GradientTexture2D.new()
	gt.gradient = g
	gt.fill = GradientTexture2D.FILL_RADIAL
	gt.fill_from = Vector2(0.5, 0.5)
	gt.fill_to = Vector2(1.0, 0.5)
	gt.width = size
	gt.height = size
	return gt


func _hills(base: float, amp: float, phase: float, color: Color) -> Polygon2D:
	var pts := PackedVector2Array()
	for x in range(0, 328, 8):
		pts.append(Vector2(x, base + sin(x * 0.028 + phase) * amp + sin(x * 0.085 + phase * 2.0) * amp * 0.35))
	pts.append(Vector2(320, 180))
	pts.append(Vector2(0, 180))
	var p := Polygon2D.new()
	p.polygon = pts
	p.color = color
	return p


func _build_sky() -> void:
	var bg := CanvasLayer.new()
	bg.layer = -5
	add_child(bg)
	var sky := _band([0.0, 0.14, 0.28, 0.42, 0.56, 0.70, 0.84],
		[Color("101026"), Color("15152f"), Color("1b1a3a"), Color("23204a"), Color("2d2758"), Color("3a3068"), Color("4a3b78")], 180)
	sky.size = Vector2(320, 180)
	bg.add_child(sky)
	var rng := RandomNumberGenerator.new()
	rng.seed = 12
	for i in 46:                                   # twinkling stars
		var s := ColorRect.new()
		s.size = Vector2(1, 1) if rng.randf() < 0.8 else Vector2(2, 1)
		s.position = Vector2(rng.randi_range(0, 319), rng.randi_range(0, 96))
		s.color = [Color("f5f0e6"), Color("a6e0f0"), Color("9a86c8")][rng.randi() % 3]
		bg.add_child(s)
		var tw := create_tween().set_loops()
		tw.tween_interval(rng.randf() * 2.0)
		tw.tween_property(s, "modulate:a", 0.25, rng.randf_range(0.8, 2.2))
		tw.tween_property(s, "modulate:a", 1.0, rng.randf_range(0.8, 2.2))
	var halo := TextureRect.new()
	halo.texture = _radial(Color(1.0, 0.94, 0.7, 0.30), 110)
	halo.position = Vector2(266 - 55, 34 - 55)
	bg.add_child(halo)
	var moon := TextureRect.new()
	moon.texture = MOON
	moon.position = Vector2(266 - 14, 34 - 14)
	bg.add_child(moon)
	bg.add_child(_hills(100.0, 8.0, 0.6, Color("2a2352")))
	bg.add_child(_hills(114.0, 6.0, 2.4, Color("1d1a3c")))


# ------------------------------------------------------------------ the lit world: trees, ground, the keeper, the shrine
func _sprite(tex: Texture2D, region: Rect2, pos: Vector2, offset: Vector2) -> Sprite2D:
	var at := AtlasTexture.new()
	at.atlas = tex
	at.region = region
	var s := Sprite2D.new()
	s.texture = at
	s.position = pos
	s.offset = offset
	return s


func _light(pos: Vector2, color: Color, energy: float, radius: float) -> PointLight2D:
	var l := PointLight2D.new()
	l.texture = _radial(Color.WHITE, 128)
	l.texture_scale = radius / 64.0
	l.color = color
	l.energy = energy
	l.position = pos
	add_child(l)
	return l


func _build_world() -> void:
	var cm := CanvasModulate.new()                 # night: everything not touched by a light is dark and blue
	cm.color = Color(0.40, 0.43, 0.70)
	add_child(cm)
	var rng := RandomNumberGenerator.new()
	rng.seed = 5
	for ty in [120, 136, 152, 168]:
		for tx in range(0, 320, 16):
			var r := rng.randf()
			var cell := Vector2(rng.randi_range(0, 3) * 16, 0) if r < 0.85 else Vector2(rng.randi_range(4, 7) * 16, 0)
			var g := _sprite(GRASS, Rect2(cell, Vector2(16, 16)), Vector2(tx, ty), Vector2.ZERO)
			g.centered = false
			add_child(g)
	var stage := Node2D.new()
	stage.y_sort_enabled = true
	add_child(stage)
	for t in [["l", 128, 142], ["s", 156, 136], ["l", 306, 146], ["s", 290, 138], ["s", 10, 140], ["l", 176, 150]]:
		var big: bool = t[0] == "l"
		stage.add_child(_sprite(TREE_L if big else TREE_S, Rect2(0, 0, 32 if big else 24, 40 if big else 32),
			Vector2(t[1], t[2] - (20 if big else 16)), Vector2.ZERO))

	var shrine := AnimatedSprite2D.new()
	shrine.sprite_frames = SHRINE
	shrine.offset = Vector2(0, -16)
	shrine.position = Vector2(262, 154)
	stage.add_child(shrine)
	shrine.play("lit")
	var hero := AnimatedSprite2D.new()
	hero.sprite_frames = PLAYER
	hero.offset = Vector2(0, -14)
	hero.position = Vector2(214, 156)
	stage.add_child(hero)
	hero.play("idle_right")
	var cat := AnimatedSprite2D.new()
	cat.sprite_frames = CAT
	cat.offset = Vector2(0, -8)
	cat.position = Vector2(236, 158)
	stage.add_child(cat)
	cat.play("idle_left")

	_shrine_light = _light(Vector2(262, 138), Color("ffb347"), 1.8, 80.0)
	_light(Vector2(209, 147), Color("ff9a3c"), 1.1, 44.0)             # the keeper's lantern
	var pulse := create_tween().set_loops()
	pulse.tween_property(_shrine_light, "energy", 1.35, 0.9).set_trans(Tween.TRANS_SINE)
	pulse.tween_property(_shrine_light, "energy", 1.8, 0.7).set_trans(Tween.TRANS_SINE)

	var embers := CPUParticles2D.new()
	embers.position = Vector2(262, 128)
	embers.amount = 16
	embers.lifetime = 3.6
	embers.preprocess = 3.6
	embers.direction = Vector2(0.1, -1)
	embers.spread = 28.0
	embers.initial_velocity_min = 8.0
	embers.initial_velocity_max = 22.0
	embers.gravity = Vector2.ZERO
	embers.scale_amount_min = 1.0
	embers.scale_amount_max = 1.6
	var ramp := Gradient.new()
	ramp.colors = PackedColorArray([Color("fff0a0"), Color("f08a2a"), Color(0.78, 0.38, 0.12, 0.0)])
	ramp.offsets = PackedFloat32Array([0.0, 0.4, 1.0])
	embers.color_ramp = ramp
	add_child(embers)
	for i in 9:                                    # fireflies drifting around the trees
		var f := ColorRect.new()
		f.size = Vector2(2, 2)
		f.color = Color("e8f58a")
		add_child(f)
		_fireflies.append({"node": f, "home": Vector2(rng.randf_range(110, 316), rng.randf_range(112, 150)),
			"ph": rng.randf() * TAU, "sp": rng.randf_range(0.5, 1.2)})


# ------------------------------------------------------------------ ui
func _panel(pos: Vector2, size: Vector2, title: String) -> Control:
	var p := NinePatchRect.new()
	p.texture = BOX
	for side in ["left", "right", "top", "bottom"]:
		p.set("patch_margin_" + side, 8)
	p.position = pos
	p.size = size
	var l := Label.new()
	l.text = title
	l.position = Vector2(0, 8)
	l.size = Vector2(size.x, 10)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.add_theme_font_override("font", FONT)
	l.add_theme_font_size_override("font_size", 8)
	l.add_theme_color_override("font_color", Color("ffc44a"))
	p.add_child(l)
	p.visible = false
	return p


func _text(parent: Node, text: String, pos: Vector2, color: Color) -> Label:
	var l := Label.new()
	l.text = text
	l.position = pos
	l.add_theme_font_override("font", FONT)
	l.add_theme_font_size_override("font_size", 8)
	l.add_theme_color_override("font_color", color)
	l.add_theme_color_override("font_shadow_color", Color("1b1b2f"))
	l.add_theme_constant_override("shadow_offset_x", 1)
	l.add_theme_constant_override("shadow_offset_y", 1)
	parent.add_child(l)
	return l


func _build_ui() -> void:
	var mist_layer := CanvasLayer.new()
	mist_layer.layer = 2
	add_child(mist_layer)
	_mist = TextureRect.new()
	_mist.texture = MIST
	_mist.stretch_mode = TextureRect.STRETCH_TILE
	_mist.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	_mist.size = Vector2(320 + 64, 180 + 64)
	_mist.modulate = Color(1, 1, 1, 0.2)
	_mist.mouse_filter = Control.MOUSE_FILTER_IGNORE
	mist_layer.add_child(_mist)

	var ui := CanvasLayer.new()
	ui.layer = 5
	add_child(ui)
	var shade := TextureRect.new()                 # darkens the left so the menu reads against the scene
	var g := Gradient.new()
	g.colors = PackedColorArray([Color(0.04, 0.03, 0.1, 0.8), Color(0.04, 0.03, 0.1, 0.0)])
	var gt := GradientTexture2D.new()
	gt.gradient = g
	gt.width = 200
	gt.height = 1
	gt.fill_from = Vector2(0, 0)
	gt.fill_to = Vector2(1, 0)
	shade.texture = gt
	shade.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	shade.stretch_mode = TextureRect.STRETCH_SCALE
	shade.size = Vector2(200, 180)
	shade.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ui.add_child(shade)

	_logo = TextureRect.new()
	_logo.texture = LOGO
	_logo.position = Vector2(22, 16)
	_logo.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ui.add_child(_logo)
	var sub := _text(ui, "A TALE OF LANTERNS AND MIST", Vector2(30, 60), Color("b9a8e8"))
	sub.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var logo_sparks := CPUParticles2D.new()        # embers lifting off the lettering
	logo_sparks.position = Vector2(22 + 106, 18)
	logo_sparks.amount = 10
	logo_sparks.lifetime = 2.6
	logo_sparks.preprocess = 2.6
	logo_sparks.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
	logo_sparks.emission_rect_extents = Vector2(100, 2)
	logo_sparks.direction = Vector2(0, -1)
	logo_sparks.spread = 15.0
	logo_sparks.initial_velocity_min = 5.0
	logo_sparks.initial_velocity_max = 12.0
	logo_sparks.gravity = Vector2.ZERO
	logo_sparks.color = Color("ffc44a")
	ui.add_child(logo_sparks)

	_menu = MenuList.new()
	_menu.position = Vector2(30, 92)
	ui.add_child(_menu)
	_menu.setup(["NEW GAME", "OPTIONS", "CREDITS", "QUIT"])
	_menu.chosen.connect(_on_main)

	_text(ui, "W/S SELECT   ENTER CONFIRM", Vector2(8, 169), Color("8a7fb0")).mouse_filter = Control.MOUSE_FILTER_IGNORE
	_text(ui, "V1.0", Vector2(320 - 8 - 24, 169), Color("8a7fb0")).mouse_filter = Control.MOUSE_FILTER_IGNORE

	_options_box = _panel(Vector2(60, 32), Vector2(200, 116), "OPTIONS")
	ui.add_child(_options_box)
	_options = OptionsPanel.new()
	_options.position = Vector2(16, 26)
	_options_box.add_child(_options)
	_options.closed.connect(func(): _show("main"))

	_credits_box = _panel(Vector2(52, 20), Vector2(216, 140), "CREDITS")
	ui.add_child(_credits_box)
	var clip := Control.new()
	clip.clip_contents = true
	clip.position = Vector2(12, 24)
	clip.size = Vector2(192, 96)
	_credits_box.add_child(clip)
	_credits_text = _text(clip, CREDITS, Vector2(0, 96), Color("f5f0e6"))
	_credits_text.size = Vector2(192, 200)
	_credits_text.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	var any_key := _text(_credits_box, "PRESS ANY KEY", Vector2(0, 126), Color("8a7fb0"))
	any_key.size = Vector2(216, 10)
	any_key.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER


func _show(state: String) -> void:
	_state = state
	_menu.active = state == "main"
	_options_box.visible = state == "options"
	_credits_box.visible = state == "credits"
	if state == "options":
		_options.open()
	elif state == "credits":
		_credits_text.position.y = 96


func _on_main(i: int) -> void:
	match i:
		0: _new_game()
		1: _show("options")
		2: _show("credits")
		3: _quit()


func _new_game() -> void:
	if _go:
		return
	_go = true
	_menu.active = false
	await Transition.dissolve_out(0.9)
	get_tree().change_scene_to_file("res://scenes/main.tscn")


func _quit() -> void:
	if _go:
		return
	_go = true
	_menu.active = false
	await Transition.fade_out(0.6)
	get_tree().quit()


func _unhandled_input(event: InputEvent) -> void:
	if _state == "credits" and event.is_pressed() and (event is InputEventKey or event is InputEventMouseButton):
		Audio.play_sfx("menu_back")
		_show("main")
		get_viewport().set_input_as_handled()


func _process(delta: float) -> void:
	_t += delta
	_mist.position = Vector2(-fmod(_t * 6.0, 64.0), -fmod(_t * 2.0, 64.0))
	_logo.position.y = 16.0 + sin(_t * 1.6) * 1.0
	for f in _fireflies:
		var n: ColorRect = f.node
		var p: float = f.ph + _t * f.sp
		n.position = (f.home as Vector2) + Vector2(sin(p) * 9.0, cos(p * 1.3) * 5.0)
		n.modulate.a = 0.35 + 0.65 * (0.5 + 0.5 * sin(_t * 3.0 * f.sp + f.ph))
	if _state == "credits":
		_credits_text.position.y -= delta * 9.0
		if _credits_text.position.y < -_credits_text.size.y + 24.0:
			_credits_text.position.y = 96
	if _shot != "":
		_frame += 1
		if _frame == 140:
			get_viewport().get_texture().get_image().save_png(_shot)
			get_tree().quit()
